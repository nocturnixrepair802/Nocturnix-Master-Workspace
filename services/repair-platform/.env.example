# Public read-only iFixit API v2.0 configuration. No credentials are required.
NOCTURNIX_IFIXIT_BASE_URL=https://www.ifixit.com/api/2.0
NOCTURNIX_IFIXIT_TIMEOUT_SECONDS=10
# ============================================================
# Mobile Sentrix Integration
# ============================================================

# Mobile Sentrix API environment.
#
# Preproduction:
# MOBILESENTRIX_BASE_URL=https://preprod.mobilesentrix.com
#
# Production:
MOBILESENTRIX_BASE_URL=https://www.mobilesentrix.com

# OAuth 1.0a consumer credentials issued for the
# Nocturnix Mobile Repair integration.
#
# Never commit real credential values.
MOBILESENTRIX_CONSUMER_KEY=
MOBILESENTRIX_CONSUMER_SECRET=

# OAuth access credentials received after authorization.
#
# Never commit real credential values.
MOBILESENTRIX_ACCESS_TOKEN=
MOBILESENTRIX_ACCESS_TOKEN_SECRET=

# OAuth callback registered with Mobile Sentrix.
#
# Local development example:
MOBILESENTRIX_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/mobilesentrix/oauth/callback

# Controls whether newly issued access tokens are written back
# to the local .env file after OAuth authorization.
#
# true:
#   Appropriate for the current local Nocturnix development setup.
#
# false:
#   Recommended when production secrets are supplied externally
#   by the host, service manager, container, or secret store.
MOBILESENTRIX_PERSIST_TOKENS_TO_ENV_FILE=true
