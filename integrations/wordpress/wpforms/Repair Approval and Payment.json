      "confirmations": {
        "1": {
          "name": "Repair Request Successfully Submitted",
          "type": "message",
          "message": "<h1>Repair Request Successfully Submitted<\/h1>\r\n<p>Thank you for choosing <strong>Nocturnix Mobile Repair<\/strong>.<\/p>\r\n<p>Your repair request has been successfully submitted and is now being reviewed by our team.<\/p>\r\n<h3>What happens next?<\/h3>\r\n<ul>\r\n<li>\r\n<p>We will review the information and photos you provided.<\/p>\r\n<\/li>\r\n<li>\r\n<p>If additional information is needed, we will contact you using your preferred contact method.<\/p>\r\n<\/li>\r\n<li>\r\n<p>If your device appears repairable, we will discuss the next steps, estimated pricing, parts availability, and scheduling.<\/p>\r\n<\/li>\r\n<\/ul>\r\n<p><strong>Please note:<\/strong> Submitting this form is a request for repair and does not guarantee repair services or a final estimate.<\/p>\r\n<p>We appreciate the opportunity to earn your business and look forward to assisting you.<\/p>\r\n<p><strong>Nocturnix Mobile Repair<\/strong><br \/>Professional Mobile Device Repair<\/p>\r\n<p class=\"PDq2pG_selectionAnchorContainer\" data-start=\"2143\" data-end=\"2169\">Need immediate assistance?<\/p>\r\n<p data-start=\"2171\" data-end=\"2203\">Call or Text:<br \/><strong data-start=\"2185\" data-end=\"2203\">(802) 449-2171<\/strong><\/p>\r\n<p data-start=\"2205\" data-end=\"2207\">or<\/p>\r\n<p data-start=\"2209\" data-end=\"2228\">Visit our <a href=\"https:\/\/nocturnixrepair.com\/faq\/\">FAQ<\/a> page<\/p>",
          "message_scroll": "1",
          "page": "",
