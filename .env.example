NOCTURNIX_ENVIRONMENT=development
NOCTURNIX_HOST=127.0.0.1
NOCTURNIX_PORT=8000
NOCTURNIX_LOG_LEVEL=INFO
NOCTURNIX_MOCK_PROVIDERS_ENABLED=true
NOCTURNIX_EXTERNAL_PROVIDERS_ENABLED=false
NOCTURNIX_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
NOCTURNIX_RATE_LIMIT_PER_MINUTE=120
NOCTURNIX_KNOWLEDGE_BASE_PATH=src/nocturnix/knowledge
NOCTURNIX_PUBLIC_CONTACT_MESSAGE=Development mock assistant only.
NOCTURNIX_DEV_IDENTITY_ENABLED=true

# v0.1.4 development authentication and mock OAuth settings. Do not commit real keys.
NOCTURNIX_AUTH_MODE=session
NOCTURNIX_ALLOW_DEVELOPMENT_REGISTRATION=false
NOCTURNIX_ALLOW_DEVELOPMENT_HEADER_AUTH=false
NOCTURNIX_ALLOW_DEVELOPMENT_PASSWORD_RESET_DELIVERY=false
NOCTURNIX_SESSION_COOKIE_NAME=nocturnix_session
NOCTURNIX_SESSION_IDLE_MINUTES=30
NOCTURNIX_SESSION_ABSOLUTE_HOURS=12
NOCTURNIX_SESSION_COOKIE_SECURE=false
NOCTURNIX_SESSION_COOKIE_SAMESITE=lax
NOCTURNIX_LOGIN_MAX_ATTEMPTS=5
NOCTURNIX_LOGIN_LOCKOUT_MINUTES=15
NOCTURNIX_PASSWORD_RESET_MINUTES=20
NOCTURNIX_OAUTH_STATE_MINUTES=10
NOCTURNIX_ALLOWED_REDIRECT_URIS=http://127.0.0.1:8000/
NOCTURNIX_SECRET_STORAGE_ENABLED=false
NOCTURNIX_SECRET_ENCRYPTION_KEY=
NOCTURNIX_SECRET_KEY_VERSION=development-v1
NOCTURNIX_MOCK_OAUTH_ENABLED=true

# Optional live coding assistant (development only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
