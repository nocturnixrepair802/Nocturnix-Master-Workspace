NOCTURNIX_ENVIRONMENT=development
NOCTURNIX_HOST=127.0.0.1
NOCTURNIX_PORT=8000
NOCTURNIX_LOG_LEVEL=INFO
NOCTURNIX_MOCK_PROVIDERS_ENABLED=true
NOCTURNIX_EXTERNAL_PROVIDERS_ENABLED=false
NOCTURNIX_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
NOCTURNIX_RATE_LIMIT_PER_MINUTE=120
NOCTURNIX_KNOWLEDGE_BASE_PATH=src/nocturnix/knowledge
NOCTURNIX_PUBLIC_CONTACT_MESSAGE=Development mock assistant only.
NOCTURNIX_DEV_IDENTITY_ENABLED=true
